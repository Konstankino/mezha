{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_ASKPASS": "",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": "",
    "GIT_TERMINAL_PROMPT": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "mezha hook approval-gate --protocol 1 --gate 'git push' || exit 2",
            "shell": "bash",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Edit(/mezha.toml)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/.mezha-state.json)",
      "Edit(/mezha/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/rules/**)",
      "Bash(mezha compile *)",
      "Bash(mezha apply *)",
      "Bash(mezha init *)"
    ],
    "deny": [
      "Bash(mezha approve *)",
      "Edit(~/.mezha/**)",
      "Edit(/.claude/agent-memory/**)",
      "Edit(/.claude/agent-memory-local/**)",
      "Edit(~/.claude/agent-memory/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.config/hub)",
      "Read(~/.config/op/**)",
      "Read(~/.gcm/**)",
      "Read(~/.password-store/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.yarnrc.yml)",
      "Read(~/.cargo/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.pulumi/credentials.json)",
      "Read(~/.vault-token)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "GH_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GITHUB_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GH_ENTERPRISE_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GITHUB_ENTERPRISE_TOKEN"
        },
        {
          "mode": "deny",
          "name": "HOMEBREW_GITHUB_API_TOKEN"
        },
        {
          "mode": "deny",
          "name": "ACTIONS_ID_TOKEN_REQUEST_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GITLAB_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GL_TOKEN"
        },
        {
          "mode": "deny",
          "name": "CI_JOB_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GITEA_TOKEN"
        },
        {
          "mode": "deny",
          "name": "AWS_ACCESS_KEY_ID"
        },
        {
          "mode": "deny",
          "name": "AWS_SECRET_ACCESS_KEY"
        },
        {
          "mode": "deny",
          "name": "AWS_SESSION_TOKEN"
        },
        {
          "mode": "deny",
          "name": "AZURE_CLIENT_SECRET"
        },
        {
          "mode": "deny",
          "name": "GOOGLE_APPLICATION_CREDENTIALS"
        },
        {
          "mode": "deny",
          "name": "NPM_TOKEN"
        },
        {
          "mode": "deny",
          "name": "NODE_AUTH_TOKEN"
        },
        {
          "mode": "deny",
          "name": "YARN_NPM_AUTH_TOKEN"
        },
        {
          "mode": "deny",
          "name": "CARGO_REGISTRY_TOKEN"
        },
        {
          "mode": "deny",
          "name": "TWINE_USERNAME"
        },
        {
          "mode": "deny",
          "name": "TWINE_PASSWORD"
        },
        {
          "mode": "deny",
          "name": "PYPI_TOKEN"
        },
        {
          "mode": "deny",
          "name": "UV_PUBLISH_TOKEN"
        },
        {
          "mode": "deny",
          "name": "POETRY_PYPI_TOKEN_PYPI"
        },
        {
          "mode": "deny",
          "name": "SSH_AUTH_SOCK"
        },
        {
          "mode": "deny",
          "name": "VSCODE_GIT_IPC_HANDLE"
        },
        {
          "mode": "deny",
          "name": "VSCODE_GIT_ASKPASS_MAIN"
        },
        {
          "mode": "deny",
          "name": "VSCODE_GIT_ASKPASS_NODE"
        },
        {
          "mode": "deny",
          "name": "WSL_INTEROP"
        }
      ],
      "files": [
        {
          "mode": "deny",
          "path": "~/.ssh"
        },
        {
          "mode": "deny",
          "path": "~/.gnupg"
        },
        {
          "mode": "deny",
          "path": "~/.aws"
        },
        {
          "mode": "deny",
          "path": "~/.azure"
        },
        {
          "mode": "deny",
          "path": "~/.config/gcloud"
        },
        {
          "mode": "deny",
          "path": "~/.kube"
        },
        {
          "mode": "deny",
          "path": "~/.config/gh"
        },
        {
          "mode": "deny",
          "path": "~/.config/glab-cli"
        },
        {
          "mode": "deny",
          "path": "~/.config/hub"
        },
        {
          "mode": "deny",
          "path": "~/.config/op"
        },
        {
          "mode": "deny",
          "path": "~/.gcm"
        },
        {
          "mode": "deny",
          "path": "~/.password-store"
        },
        {
          "mode": "deny",
          "path": "~/.netrc"
        },
        {
          "mode": "deny",
          "path": "~/.git-credentials"
        },
        {
          "mode": "deny",
          "path": "~/.config/git/credentials"
        },
        {
          "mode": "deny",
          "path": "~/.docker/config.json"
        },
        {
          "mode": "deny",
          "path": "~/.npmrc"
        },
        {
          "mode": "deny",
          "path": "~/.yarnrc.yml"
        },
        {
          "mode": "deny",
          "path": "~/.cargo/credentials"
        },
        {
          "mode": "deny",
          "path": "~/.cargo/credentials.toml"
        },
        {
          "mode": "deny",
          "path": "~/.pypirc"
        },
        {
          "mode": "deny",
          "path": "~/.gem/credentials"
        },
        {
          "mode": "deny",
          "path": "~/.terraform.d/credentials.tfrc.json"
        },
        {
          "mode": "deny",
          "path": "~/.pulumi/credentials.json"
        },
        {
          "mode": "deny",
          "path": "~/.vault-token"
        }
      ]
    },
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyWrite": [
        "~/.mezha",
        "./mezha.toml",
        "./.claude/.mezha-state.json",
        "./mezha",
        "./.claude/rules",
        "./.claude/agent-memory",
        "./.claude/agent-memory-local",
        "~/.claude/agent-memory"
      ]
    },
    "network": {
      "allowedDomains": [
        "crates.io"
      ],
      "deniedDomains": [
        "github.com",
        "api.github.com",
        "uploads.github.com",
        "ssh.github.com",
        "gitlab.com",
        "bitbucket.org",
        "api.bitbucket.org"
      ]
    }
  }
}
